# PayPal sandbox app credentials (developer.paypal.com > Apps & Credentials > Sandbox).
# The app must be linked to a US sandbox *Business* account, otherwise card payments are rejected.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Any OpenAI-compatible chat endpoint. Defaults target Google Gemini's free tier.
# Leave LLM_API_KEY empty to run with the three sample complaints only (their AI answers ship in cache/).
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite
# LLM_FALLBACK_MODEL=gemini-2.5-flash-lite

# Public HTTPS origin of the deployment, to receive PayPal webhooks (Render sets RENDER_EXTERNAL_URL for you).
# PUBLIC_URL=
